{
  "name": "ok2ride",
  "version": "0.1.0",
  "description": "OK2Ride: cognitive capability assessment web component (randomised reaction, steering, go/no-go, trail, memory and Stroop tests) for gating micromobility vehicle unlocks.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "./dist/ok2ride.js",
  "module": "./dist/ok2ride.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/ok2ride.js",
      "default": "./dist/ok2ride.js"
    },
    "./token": {
      "types": "./dist/types/token.d.ts",
      "import": "./dist/token.js",
      "default": "./dist/token.js"
    }
  },
  "files": [
    "dist",
    "custom-elements.json"
  ],
  "sideEffects": true,
  "customElements": "custom-elements.json",
  "scripts": {
    "dev": "vite --config vite.site.config.ts",
    "build": "vite build && vite build --config vite.token.config.ts && tsc -p tsconfig.build.json",
    "site:build": "vite build --config vite.site.config.ts",
    "site:preview": "vite preview --config vite.site.config.ts",
    "rent": "vite --config vite.rent.config.ts",
    "rent:build": "vite build --config vite.rent.config.ts",
    "rent:preview": "vite preview --config vite.rent.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test && npm run build && npm run site:build && npm run rent:build"
  },
  "keywords": [
    "ok2ride",
    "web-component",
    "custom-element",
    "psychomotor-vigilance",
    "pvt",
    "captcha",
    "micromobility"
  ],
  "devDependencies": {
    "happy-dom": "^20.14.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
